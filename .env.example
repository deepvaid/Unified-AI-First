# Realistic assistant voice (cloud TTS). Server-side only — NOT VITE_-prefixed,
# so it is never bundled into the client. Copy to .env.local for local dev, and
# add the same vars in the Vercel project settings for production.
#
# Without a key, the assistant transparently falls back to the browser voice.

# OpenAI key used by /api/tts (api/tts.ts + the Vite dev middleware)
OPENAI_API_KEY=

# Optional overrides
# TTS_VOICE=nova        # alloy | echo | fable | onyx | nova | shimmer
# TTS_MODEL=tts-1       # tts-1 (fast, cheap) | tts-1-hd (higher quality)
