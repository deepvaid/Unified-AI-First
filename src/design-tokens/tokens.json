      "$value": "9999px",
      "$type": "dimension"
    },
    "chip": {
      "$value": "8px",
      "$type": "dimension"
    }
  },
  "shadow": {
    "$description": "Softer, humane elevation — depth comes from hairline + tint, not heavy drops",
    "sm": {
      "$value": {
        "x": "0",
        "y": "1",
        "blur": "2",
        "spread": "0",
        "color": "rgba(11, 53, 88, 0.04)",
        "type": "dropShadow"
      },
      "$type": "shadow"
    },
    "md": {
      "$value": {
        "x": "0",
        "y": "2",
        "blur": "16",
        "spread": "-8",
        "color": "rgba(11, 53, 88, 0.08)",
        "type": "dropShadow"
      },
      "$type": "shadow"
    },
    "lg": {
      "$value": {
        "x": "0",
        "y": "8",
        "blur": "32",
        "spread": "-12",
        "color": "rgba(11, 53, 88, 0.1)",
        "type": "dropShadow"
      },
      "$type": "shadow"
    }
  },
  "transition": {
    "$description": "Animation durations",
    "fast": {
      "$value": "0.15s ease",
      "$type": "transition"
    },
    "base": {
      "$value": "0.2s ease",
      "$type": "transition"
    }
  },
  "motion": {
    "$description": "Motion system — durations, easings, and stagger step for the confident-editorial evolution",
    "duration": {
      "instant": { "$value": "80ms", "$type": "duration" },
      "fast": { "$value": "140ms", "$type": "duration" },
      "base": { "$value": "200ms", "$type": "duration" },
      "slow": { "$value": "320ms", "$type": "duration" },
      "entrance": { "$value": "400ms", "$type": "duration" }
    },
    "easing": {
      "standard": { "$value": "cubic-bezier(0.2, 0.8, 0.2, 1)", "$type": "cubicBezier" },
      "exit": { "$value": "cubic-bezier(0.4, 0, 1, 1)", "$type": "cubicBezier" }
    },
    "stagger": {
      "step": { "$value": "40ms", "$type": "duration" }
    }
  },
